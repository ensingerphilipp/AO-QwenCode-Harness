{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ensingerphilipp/AO-QwenCode-Harness/blob/main/global/qwen/skills/ao-pr-review/references/project-risk-config.schema.json",
  "title": "AO Qwen Code project semantic-review risk configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "highRiskPaths": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "highRiskLabels": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
