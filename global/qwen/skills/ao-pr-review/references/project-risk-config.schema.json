{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ensingerphilipp/AO-QwenCode-Harness/blob/main/global/qwen/skills/ao-pr-review/references/project-risk-config.schema.json",
  "title": "AO Qwen Code project semantic-review risk configuration",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "highRiskPaths": {
          "$ref": "#/$defs/stringArray"
        },
        "highRiskLabels": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "highRiskPaths": {
          "$ref": "#/$defs/stringArray"
        },
        "softRiskPaths": {
          "$ref": "#/$defs/stringArray"
        },
        "highRiskLabels": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
