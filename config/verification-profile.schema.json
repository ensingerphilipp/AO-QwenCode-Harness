{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ensingerphilipp/AO-QwenCode-Harness/blob/main/config/verification-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "description", "detectionSignals", "requiredInspectionFacts", "requiredRenderTokens", "verificationCandidates", "ciSetupCandidates"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "detectionSignals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "requiredInspectionFacts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "requiredRenderTokens": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "uniqueItems": true},
    "verificationCandidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "ciSetupCandidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "includeWhen", "template"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "includeWhen": {"type": "string", "minLength": 1},
        "template": {"type": "string", "minLength": 1}
      }
    }
  }
}
