{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ensingerphilipp/AO-QwenCode-Harness/blob/main/config/project-inspection.schema.json",
  "title": "AO Qwen Code project inspection result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "facts",
    "templateValues",
    "verification",
    "reviewRisk",
    "decisionsRequired"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "remote",
        "defaultBranch"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "defaultBranch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "templateValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PROJECT_NAME",
        "PROJECT_PURPOSE",
        "PROJECT_GOALS",
        "PROJECT_NON_GOALS",
        "AUTONOMOUS_CHANGE_SCOPE",
        "HITL_BOUNDARIES",
        "PUBLIC_CONTRACTS",
        "SECURITY_BOUNDARIES",
        "PERSISTENCE_STATE",
        "DEPLOYMENT_SUPPORT_POLICY",
        "PROJECT_ACCEPTANCE_NOTES",
        "SYSTEM_OVERVIEW",
        "COMPONENT_BOUNDARIES",
        "PRIMARY_FLOWS",
        "ARCHITECTURE_STATE_AND_PERSISTENCE",
        "EXTERNAL_SYSTEMS",
        "RUNTIME_DEPENDENCIES",
        "BUILD_AND_RELEASE",
        "CI_VERIFICATION_NOTES",
        "APPROVED_TECHNICAL_DECISIONS",
        "KNOWN_ARCHITECTURE_RISKS",
        "PROJECT_REVIEW_INVARIANTS",
        "CI_RUNNER",
        "CI_TIMEOUT_MINUTES",
        "CI_SETUP_STEPS"
      ],
      "properties": {
        "PROJECT_NAME": {
          "type": [
            "string",
            "null"
          ]
        },
        "PROJECT_PURPOSE": {
          "type": [
            "string",
            "null"
          ]
        },
        "PROJECT_GOALS": {
          "type": [
            "string",
            "null"
          ]
        },
        "PROJECT_NON_GOALS": {
          "type": [
            "string",
            "null"
          ]
        },
        "AUTONOMOUS_CHANGE_SCOPE": {
          "type": [
            "string",
            "null"
          ]
        },
        "HITL_BOUNDARIES": {
          "type": [
            "string",
            "null"
          ]
        },
        "PUBLIC_CONTRACTS": {
          "type": [
            "string",
            "null"
          ]
        },
        "SECURITY_BOUNDARIES": {
          "type": [
            "string",
            "null"
          ]
        },
        "PERSISTENCE_STATE": {
          "type": [
            "string",
            "null"
          ]
        },
        "DEPLOYMENT_SUPPORT_POLICY": {
          "type": [
            "string",
            "null"
          ]
        },
        "PROJECT_ACCEPTANCE_NOTES": {
          "type": [
            "string",
            "null"
          ]
        },
        "SYSTEM_OVERVIEW": {
          "type": [
            "string",
            "null"
          ]
        },
        "COMPONENT_BOUNDARIES": {
          "type": [
            "string",
            "null"
          ]
        },
        "PRIMARY_FLOWS": {
          "type": [
            "string",
            "null"
          ]
        },
        "ARCHITECTURE_STATE_AND_PERSISTENCE": {
          "type": [
            "string",
            "null"
          ]
        },
        "EXTERNAL_SYSTEMS": {
          "type": [
            "string",
            "null"
          ]
        },
        "RUNTIME_DEPENDENCIES": {
          "type": [
            "string",
            "null"
          ]
        },
        "BUILD_AND_RELEASE": {
          "type": [
            "string",
            "null"
          ]
        },
        "CI_VERIFICATION_NOTES": {
          "type": [
            "string",
            "null"
          ]
        },
        "APPROVED_TECHNICAL_DECISIONS": {
          "type": [
            "string",
            "null"
          ]
        },
        "KNOWN_ARCHITECTURE_RISKS": {
          "type": [
            "string",
            "null"
          ]
        },
        "PROJECT_REVIEW_INVARIANTS": {
          "type": [
            "string",
            "null"
          ]
        },
        "CI_RUNNER": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "CI_TIMEOUT_MINUTES": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[1-9][0-9]{0,2}$"
        },
        "CI_SETUP_STEPS": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedProfiles",
        "preflight",
        "checks"
      ],
      "properties": {
        "selectedProfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "generic",
              "go",
              "node",
              "python",
              "rust",
              "go-node"
            ]
          }
        },
        "preflight": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    "reviewRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "highRiskPaths",
        "highRiskLabels",
        "evidence"
      ],
      "properties": {
        "highRiskPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "highRiskLabels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "decisionsRequired": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "detail"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "statement",
        "evidence"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "rationale",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "reason",
        "affectedTokens"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "affectedTokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PROJECT_NAME",
              "PROJECT_PURPOSE",
              "PROJECT_GOALS",
              "PROJECT_NON_GOALS",
              "AUTONOMOUS_CHANGE_SCOPE",
              "HITL_BOUNDARIES",
              "PUBLIC_CONTRACTS",
              "SECURITY_BOUNDARIES",
              "PERSISTENCE_STATE",
              "DEPLOYMENT_SUPPORT_POLICY",
              "PROJECT_ACCEPTANCE_NOTES",
              "SYSTEM_OVERVIEW",
              "COMPONENT_BOUNDARIES",
              "PRIMARY_FLOWS",
              "ARCHITECTURE_STATE_AND_PERSISTENCE",
              "EXTERNAL_SYSTEMS",
              "RUNTIME_DEPENDENCIES",
              "BUILD_AND_RELEASE",
              "CI_VERIFICATION_NOTES",
              "APPROVED_TECHNICAL_DECISIONS",
              "KNOWN_ARCHITECTURE_RISKS",
              "PROJECT_REVIEW_INVARIANTS",
              "CI_RUNNER",
              "CI_TIMEOUT_MINUTES",
              "CI_SETUP_STEPS"
            ]
          }
        }
      }
    }
  }
}
