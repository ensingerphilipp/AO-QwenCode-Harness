#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

run() {
  printf '\n==> %s\n' "$1"
  shift
  "$@"
}

run "Project template contract" \
  python3 -m unittest discover -s templates/project/tests -v
run "Verification profile contract" \
  python3 -m unittest discover -s templates/verify/tests -v
run "Project inspection contract" \
  python3 -m unittest discover -s templates/inspection/tests -v
run "Lifecycle refresh integration tests" \
  python3 -m unittest discover -s lifecycle/tests -v
run "Host install and project initialization tests" \
  python3 -m unittest discover -s install/tests -v
run "Semantic review Skill regression suite" \
  python3 -m unittest discover -s global/qwen/skills/ao-pr-review/tests -v

run "JSON parse validation" python3 - <<'PY'
import json
from pathlib import Path
for path in sorted(Path('.').rglob('*.json')):
    if '.git' in path.parts:
        continue
    json.loads(path.read_text(encoding='utf-8'))
print('all JSON files parse')
PY

run "No tracked Python caches" bash -c \
  '! git ls-files | grep -E "(^|/)(__pycache__/|.*\\.py[co]$)"'
run "Git whitespace check (unstaged)" git diff --check
run "Git whitespace check (staged)" git diff --cached --check

printf '\nHarness verification passed.\n'
